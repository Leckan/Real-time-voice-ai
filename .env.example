# Server-only. Never prefix a secret with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_TEXT_MODEL=gpt-5.4-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Required in production. At least 16 characters. Development uses a local fallback.
AUTH_SECRET=

# Postgres connection string. Omit it to use a single-process in-memory store.
DATABASE_URL=

# Optional. Defaults to the public OpenAI API.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_REALTIME_BASE_URL=https://api.openai.com/v1/realtime/calls

# Public origin, for example https://auric.example.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
